{
  "format": "vbs-template",
  "version": 1,
  "template": {
    "name": "Sample Full Template",
    "description": "Template minh họa logo, text, greenscreen và overlay.",
    "config": {
      "canvas": {"width": 1920, "height": 1080, "fps": 30},
      "backgroundMode": "STOCK_VIDEO",
      "subtitle": {"fontFamily": "Arial", "fontSize": 32, "bottomMargin": 20, "outlineWidth": 0, "maxWidthPercent": 96, "maxLines": 4, "bold": false, "italic": false, "shadow": 1, "renderScale": 1},
      "transition": {"minDurationMs": 600, "maxDurationMs": 900, "avoidRepeatCount": 2},
      "layers": [
        {"type":"TEXT","name":"Title","text":"VIDEO BATCH STUDIO","visible":true,"transform":{"x":80,"y":60,"width":700,"height":100,"opacity":0.9},"style":{"fontSize":54,"color":"#FFFFFF","outlineWidth":2},"effect":{}},
        {"type":"LOGO","name":"Logo","sourceReference":"sample-data/logo.png","visible":true,"transform":{"x":1660,"y":60,"width":180,"height":80,"opacity":0.75},"style":{},"effect":{"blendMode":"normal"}}
      ]
    }
  }
}
